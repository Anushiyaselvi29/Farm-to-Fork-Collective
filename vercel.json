{
  "version": 2,
  "name": "farm-to-fork-collective",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/traceability/(.*)",
      "destination": "/pages/traceability.html"
    },
    {
      "source": "/traceability",
      "destination": "/pages/traceability.html"
    },
    {
      "source": "/reset-password",
      "destination": "/pages/reset-password.html"
    },
    {
      "source": "/complete-profile",
      "destination": "/pages/complete-profile.html"
    }
  ]
}

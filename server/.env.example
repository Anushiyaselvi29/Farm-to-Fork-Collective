# ========================================================
# BACKEND SERVER ENVIRONMENT TEMPLATE (.env.example)
# Farm to Fork Collective
# ========================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Compass connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=farmtofork

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# OAuth Providers (Google & GitHub)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ========================================================
# REAL GMAIL / SMTP CONFIGURATION (Nodemailer)
# ========================================================
# Official Admin Email (All admin alerts routed here)
ADMIN_EMAIL=anushiyaselvi06@gmail.com

# EMAIL NOTIFICATION SENDER CREDENTIALS
EMAIL_USER=anushiyaselvi60@gmail.com
EMAIL_APP_PASSWORD=xxxx yyyy zzzz wwww

# OPTION A: DIRECT GMAIL SERVICE (Recommended)
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character Gmail App Password:
#    https://myaccount.google.com/apppasswords
# 3. Paste your Gmail address and 16-digit App Password below:
GMAIL_USER=anushiyaselvi60@gmail.com
GMAIL_APP_PASSWORD=xxxx yyyy zzzz wwww

# OPTION B: STANDARD SMTP SERVICE (Custom Mail Server / Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anushiyaselvi60@gmail.com
SMTP_PASS=xxxx yyyy zzzz wwww

# SENDER BRANDING
EMAIL_FROM="Farm to Fork Collective" <anushiyaselvi60@gmail.com>

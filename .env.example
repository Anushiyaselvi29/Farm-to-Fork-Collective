# ========================================================
# FARM TO FORK COLLECTIVE - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace with your local credentials:
# cp .env.example .env
# ========================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- DATABASE (MONGODB COMPASS & JSON PERSISTENCE) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=farmtofork

# --- JWT AUTHENTICATION (RFC 7519 COMPLIANT) ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# --- OAUTH 2.0 FEDERATION CREDENTIALS ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- EMAIL & OTP NOTIFICATION SERVICE (NODEMAILER) ---
ADMIN_EMAIL=anushiyaselvi06@gmail.com
EMAIL_FROM="Farm to Fork Collective" <anushiyaselvi06@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anushiyaselvi60@gmail.com
SMTP_PASS=your_email_password_or_app_token

GMAIL_USER=anushiyaselvi60@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_digit_app_password

# --- VITE FRONTEND ENVIRONMENT VARIABLES ---
VITE_API_URL=http://localhost:5000
VITE_APP_TITLE=Farm to Fork Collective
VITE_ENABLE_MOCK_FALLBACK=true
